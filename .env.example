# Copy to .env in the repo root. Paths here resolve relative to this file.
# Explicit API/CLI arguments override process environment, then this file.
DATA_DIR=../../Data/Meteorology/
START_DATE=2009-01-01
END_DATE=2026-10-10
VERBOSITY=True

# Available METRICS: temperature, dewpoint, relative_humidity, wind, cloud_cover, pressure, precipitation
METRICS=temperature,dewpoint,relative_humidity,wind,cloud_cover,pressure,precipitation
# All six settings are required for file-backed runs; check with meteorology preflight.
# False: keep saved columns/dates; fetch missing dates and new metrics across the saved range.
# True: replace the product with the requested dates/metrics.
REBUILD=False
