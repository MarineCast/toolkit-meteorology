# Copy to .env here. Do not commit .env or put tokens in logs.
# Environment variables override this file; explicit API/CLI options win.
CDSAPI_KEY=

# WGS84 collection bounds; select approved coastal/water H3 R5 centres only.
MIN_LAT=45.9
MAX_LAT=51.5
MIN_LON=-129.7
MAX_LON=-121.5

# Inclusive UTC dates. Use source-supported dates for Weather and Radiation.
START_DATE=2009-01-01
END_DATE=2026-10-10
# true: replace this product with the selected range. false: preserve and append.
REBUILD=false

# Paths resolve beside this file. DATA_DIR is the Meteorology delivery root.
DATA_DIR=../../Data/Meteorology
MARINECAST_STUDY_CONFIG=../../config/study.v1.json
# Optional: VERBOSITY=false; METRICS defaults to all seven Weather families.
